{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frontend-lab-web",
  "workers_dev": false,
  "preview_urls": false,
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-09",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frontend-lab-cms",
      "database_id": "84a90c4b-fdc4-4bc0-9030-acf7ba26f069"
    }
  ]
}
