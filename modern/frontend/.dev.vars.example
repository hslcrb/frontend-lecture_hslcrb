# For local development only. DO NOT commit .dev.vars with real credentials.
CF_ACCESS_TEAM_DOMAIN=long-flower-8d9c.cloudflareaccess.com
CF_ACCESS_AUD=YOUR_GOOGLE_ACCESS_APP_AUDIENCE
# Comma-separated exact verified Google emails of authorized teachers.
ADMIN_EMAILS=teacher@example.com
# Defaults to d1. Supabase is optional; do not configure unless a dedicated project is approved.
STUDENT_STORAGE=d1
# STUDENT_STORAGE=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SECRET_SERVER_ONLY

# Required server-only HMAC pepper (64 lowercase hex chars; never commit a real value).
AUTH_PEPPER=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
